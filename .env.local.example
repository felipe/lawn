# Local-mode lawn. Copy to .env.local and fill in the admin key.
#
# VITE_* are read at Vite build/dev time by the browser bundle.
# CONVEX_SELF_HOSTED_* are read by `bunx convex dev/deploy` to push code
# to the self-hosted Convex backend on Janus.

VITE_CONVEX_URL=http://convex.ww
VITE_CONVEX_SITE_URL=http://convex-api.ww

CONVEX_SELF_HOSTED_URL=http://convex.ww
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-1password://Homelab/convex-admin-key

# Mux credentials are NOT used in local mode — phase 3 replaces the Mux
# ingest with the lawn-media sidecar. Kept commented for reference.
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_WEBHOOK_SECRET=
